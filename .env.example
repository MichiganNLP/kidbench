# Copy to .env and fill in the keys for the providers you actually use.
# Every script reads these from the environment; nothing is ever committed.
#
#   cp .env.example .env && set -a && source .env && set +a

# Response generation and the DeepSeek-V4-Pro judge
DEEPSEEK_API_KEY=

# Response generation with GPT-5-Mini (and GPT-5.5 in the judge-selection study)
OPENAI_API_KEY=

# Response generation with Claude-Haiku-4.5 (and Claude-Opus-4.7 for judge selection)
ANTHROPIC_API_KEY=

# Response generation with Gemini-3.1-Flash-Lite (and Gemini-3.1-Pro for judge selection)
GOOGLE_API_KEY=

# Needed to download gated base models and to push fine-tuned checkpoints
HF_TOKEN=
